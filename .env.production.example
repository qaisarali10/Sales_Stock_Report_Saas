NODE_ENV=production
PORT=5000
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.example.mongodb.net/pdf_parser?retryWrites=true&w=majority
EMBEDDED_MONGO=false
MAX_UPLOAD_MB=10
REQUEST_TIMEOUT_MS=120000
MONGO_TIMEOUT_MS=10000
MAX_CONCURRENT_PARSES=2
PARSE_RATE_LIMIT=20
API_RATE_LIMIT=300
AUTH_RATE_LIMIT=10
RATE_LIMIT_WINDOW_MS=900000
AUTH_REQUIRED=false
COOKIE_SECURE=true
RETENTION_DAYS=30
TRUST_PROXY=1
